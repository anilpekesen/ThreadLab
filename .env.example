# Örnek ortam değişkenleri — gerçek değerler yalnız .env dosyasında durur.
# Bu dosya şimdilik Paddle faturalandırmasını (WooCommerce mağazaları) listeler.

# ── Paddle ───────────────────────────────────────────────────────────────
# sandbox | live — bilerek varsayılansız; boşsa Paddle'a hiç istek atılmaz
PADDLE_ENV=sandbox
# Dashboard > Developer tools > Authentication
#   sandbox: pdl_sdbx_apikey_...   live: pdl_live_apikey_...
PADDLE_API_KEY=
#   sandbox: test_...              live: live_...
PADDLE_CLIENT_TOKEN=

# Aşağıdakileri scripts/paddle-setup.ts oluşturup .env'e yazar:
#   PADDLE_ENV=... PADDLE_API_KEY=... npx vite-node scripts/paddle-setup.ts
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=
PADDLE_PRICE_PACK100=
PADDLE_PRICE_PACK300=
PADDLE_PRICE_PACK500=
